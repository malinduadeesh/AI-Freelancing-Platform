s="geometry"></mxGeometry></mxCell><mxCell id="c86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.701;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Freelancer" target="FreelancerSkill"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="AISkill" target="FreelancerSkill"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.201;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Freelancer" target="FreelancerService"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="AIService" target="FreelancerService"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.819;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Project" target="ProjectRequirement"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.176;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Project" target="ProjectSkill"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="AISkill" target="ProjectSkill"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="322"/><mxPoint x="1130" y="322"/></Array></mxGeometry></mxCell><mxCell id="c93" value="receives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Project" target="Proposal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c94" value="submits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Freelancer" target="Proposal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c95" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Proposal" target="Assignment"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c96" value="paid by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToOne;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Assignment" target="Payment"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c97" value="0..2 reviews" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=10;endSize=10;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Assignment" target="Review"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c98" value="Legend&lt;br&gt;PK: primary key&lt;br&gt;FK: foreign key&lt;br&gt;UNIQUE: unique constraint&lt;br&gt;||  exactly one&lt;br&gt;o{  zero or many&lt;br&gt;o|  zero or one&lt;br&gt;Composite keys: FreelancerSkill, FreelancerService, ProjectSkill" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="230" height="200" as="geometry"/></mxCell><mxCell id="c99" value="Data validation rules (CHECK constraints)&lt;br&gt;Project budget cannot be negative&lt;br&gt;Proposal proposed_amount cannot be negative&lt;br&gt;Assignment agreed_amount cannot be negative&lt;br&gt;Payment amount cannot be negative&lt;br&gt;Review rating must be between 1 and 5&lt;br&gt;Proposal estimated_days must be a positive number&lt;br&gt;Freelancer experience_years cannot be negative" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="310" height="210" as="geometry"/></mxCell><mxCell id="c100" value="Business rules&lt;br&gt;Freelancer, Client, Admin and Manager use separate account and login tables. Each table has its own UNIQUE email&lt;br&gt;Project status: Open, Assigned, In Progress, Completed, Cancelled&lt;br&gt;A Project can be marked Completed only when it has at least one Assignment and all its Assignments are completed&lt;br&gt;Proposal status: Pending, Accepted, Rejected, Withdrawn&lt;br&gt;A freelancer can have only one Pending proposal per project at a time. A new proposal for the same project is allowed only when the earlier one is no longer Pending (Accepted, Rejected or Withdrawn)&lt;br&gt;One Proposal can create zero or many Assignments (1 to 0..N), so one Accepted Proposal can support repeat assignments. Assignment.proposal_id is not unique&lt;br&gt;An Assignment can only be created from an Accepted Proposal&lt;br&gt;Project of an Assignment: Assignment → Proposal → Project. Freelancer of an Assignment: Assignment → Proposal → Freelancer. These are derived relationships, so Assignment has no project_id or freelancer_id&lt;br&gt;One payment record per Assignment. Multiple instalments are not supported" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="620" width="460" height="380" as="geometry"/></mxCell><mxCell id="c101" value="Review rules&lt;br&gt;Each Assignment has zero, one or two Reviews. reviewer_role is Client or Freelancer. UNIQUE(assignment_id, reviewer_role) allows at most one Client review and one Freelancer review per Assignment.&lt;br&gt;Reviews are allowed only after the Assignment is completed. The reviewer must be the actual Client or Freelancer of that Assignment: the Client owns the Project reached through Assignment → Proposal → Project, and the Freelancer is the one on that Proposal." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="1080" width="540" height="150" as="geometry"/></mxCell><mxCell id="c102" value="MySQL enforcement notes&lt;br&gt;One Pending proposal per freelancer per project: BEFORE INSERT and BEFORE UPDATE triggers on Proposal, or a UNIQUE index on (project_id, freelancer_id, pending_flag), where pending_flag is a generated column that is 1 when status is Pending and NULL otherwise&lt;br&gt;Assignment only from an Accepted Proposal: BEFORE INSERT trigger on Assignment. Do not add a UNIQUE index on Assignment.proposal_id&lt;br&gt;Reviews only after completion, and reviewer identity: BEFORE INSERT trigger on Review plus PHP session check&lt;br&gt;Project Completed rule: trigger or stored procedure&lt;br&gt;Value rules: CHECK constraints" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="1080" width="570" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>